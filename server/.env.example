PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Leave empty to run without a database. Never commit a real value.
MONGODB_URI=

# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional auth settings
SESSION_DAYS=7
COOKIE_SAME_SITE=lax
# Number of reverse proxies in front of the API in production (e.g. 1)
TRUST_PROXY=0

# Used ONLY by `npm run create-admin`. Remove ADMIN_PASSWORD after running it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=