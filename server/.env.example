# Template listing every environment variable the backend reads, with no real values.
# Port the API server listens on
PORT=5000

# Node environment: development | production
NODE_ENV=development

# Origin allowed to call this API (the Vite dev server)
CLIENT_URL=http://localhost:5173

# MongoDB connection string.
# Leave empty to run the server without a database (Phase 1 only).
# Example shape (do NOT commit a real one):
#   mongodb+srv://<username>:<password>@<cluster>/<database>
